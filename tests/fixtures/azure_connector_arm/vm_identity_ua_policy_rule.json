{
  "if": {
    "allOf": [
      {
        "equals": "Microsoft.Compute/virtualMachines",
        "field": "type"
      },
      {
        "equals": "UserAssigned",
        "field": "identity.type"
      }
    ]
  },
  "then": {
    "details": {
      "operations": [
        {
          "field": "identity.type",
          "operation": "addOrReplace",
          "value": "[concat(field('identity.type'), ',SystemAssigned')]"
        }
      ],
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "effect": "modify"
  }
}
